      "mimeType": "text/html;charset=UTF-8",
      "compression": 91756,
      "text": "\n\n\n\n\n        \n    <!doctype html>\n    <html class=\"no-js\" lang=\"en-US\">\n            <head>\n        <meta charset=\"utf-8\">\n        <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n        <title>EvergreenHealth Careers</title>\n                    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\n        <link rel=\"shortcut icon\" href=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/images/favicon.ico?v=260807065713\" type=\"image/x-icon\">\n        <link rel=\"apple-touch-icon-precomposed\" href=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/images/apple-touch-icon-precomposed.png?v=260807065713\">\n\n        <link rel=\"stylesheet\" href=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/fonts/jobvite-icons/style.css?v=260807065713\">\n        <link rel=\"stylesheet\" href=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/styles/careersite/public-desktop.css?v=260807065713\">\n        <link rel=\"stylesheet\" href=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/scripts/careersite/public/flatpickr/v4/flatpickr.min.css?v=260807065713\">\n        <script src=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/scripts/careersite/public/modernizr-3.3.1-custom.min.js?v=260807065713\"></script>\n        <script src=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/lib/moment/moment-with-locales-2.29.4.min.js?v=260807065713\"></script>\n\n                    <!--[if lte IE 8]>\n                <script src=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/scripts/careersite/public/es5-shim.min.js?v=260807065713\"></script>\n            <![endif]-->\n\n\n<!-- CWS Company-wise Google Analytics -->\n<script type=\"text/javascript\">\n    function getUserId() { return ''; }\n</script>\n<script type=\"text/javascript\">\n    function getCompanyId() { return 'qFPaVfwj'; }\n</script>\n<script type=\"text/javascript\">\n    try {\n        var enableAnonymizeIP = false;\n        var trackerId = \"UA-164954856-1\";\n        var gtagSrc = \"https://www.
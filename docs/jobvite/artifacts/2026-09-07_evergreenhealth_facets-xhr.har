uestAnimationFrame(scrollToTop);\n                //window.scrollTo(0, c - c / 8);\n                window.scrollTo(0,0);\n            }\n        };\n        \n        backToTop.addEventListener(\"click\", function(e) { \n            scrollToTop();\n            return false;\n        });\n        \n    });\n</script>\n        <a class=\"back-to-top\"><i class=\"fas fa-chevron-up\" aria-hidden=\"true\"></i><span class=\"sr-only\">Back to Top</span></a>\n\n    </body>\n\n    </html>\n"

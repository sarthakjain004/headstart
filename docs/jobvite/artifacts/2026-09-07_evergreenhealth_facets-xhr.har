-focusable:active,.sr-only-focusable:focus {position:static;width:auto;height:auto;overflow:visible;clip:auto;white-space:normal;-webkit-clip-path:none;clip-path:none}\n.list-unstyled {list-style:none;padding-left:0}\n.u-text-center {text-align:center}\n.u-text-left {text-align:left}\n.u-text-right {text-align:right}\n.r-img {border:0;max-width:100%;height:auto}\n.d-hide {display:none}\n.u-float-left {float:left}\n#footer-jobalerts {margin-top:30px}\n/*! Revisions for Evergreen Health */\n/*! Ben's Updates - 2024_02_28 */\n.jv-button.jv-button-primary:hover {background-color:#454849}\n.section#videos {padding-top:0}\n.section#videos .row {display:-webkit-box;display:-ms-flexbox;display:flex;min-width:0;min-height:0;-webkit-box-orient:vertical;-webkit-box-direction:normal;-ms-flex-direction:column;flex-direction:column;-webkit-box-align:center;-ms-flex-align:center;align-items:center;-webkit-box-pack:center;-ms-flex-pack:center;justify-content:center}\n@media (min-width:768px) {\n.section#videos .row {display:-webkit-box;display:-ms-flexbox;display:flex;min-width:0;min-height:0;-webkit-box-orient:horizontal;-webkit-box-direction:normal;-ms-flex-direction:row;flex-direction:row}}\n.video-container {margin:1rem 0;max-height:100%;width:clamp(400px,100%,800px)}\n.video-container embed,.video-container iframe,.video-container object {aspect-ratio:16/9;width:100%;height:100%}\n/*! Ben's Updates - 2024_05_02 */\nbody {-webkit-font-smoothing:antialiased}\nbody.active {overflow-y:hidden}\n.jv-page-content {padding-top:95px}\n.jv-page-header {height:auto;padding:10px 0;z-index:1000}\n.jv-page-header .jv-wrapper {padding:0 .9375rem}\n.jv-page-header .jv-wrapper:after {content:none}\n.jv-page-header nav {border-top:none}\n.jv-page-header nav a {font-size:14px;font-weight:400;line-height:70px}\n.jv-page-header nav a,.jv-page-header nav a:hover {color:#485c69}\n.jv-page-header #mobile-toggle {width:18px;height:18px}\n.jv-page-header #mobile-toggle svg {width:100%;height:100%}\n.jv-page-header nav.hide-for-desktop {background-color:#fff;height:0;left:0;opacity:0;padding:0 .9375rem;position:absolute;top:85px;-webkit-transition:height .3s ease-in-out;transition:height .3s ease-in-out;visibility:hidden;width:100%;z-index:501}\n.jv-page-container.active .jv-page-header nav.hide-for-desktop {height:calc(100vh - 85px);opacity:1;visibility:visible}\n.jv-page-header nav.hide-for-desktop ul {padding:0 .9375rem}\n.jv-page-header nav.hide-for-desktop ul li a {color:#333;display:block;padding:0}\n.hide-for-desktop {display:block}\n@media (min-width:1024px) {\n.hide-for-desktop {display:none}}\n.hide-for-mobile {display:none}\n@media (min-width:1024px) {\n.hide-for-mobile {display:block}}\n.jv-logo {margin-bottom:0}\n.jv-logo a img {width:auto;height:100%;max-height:70px}\n.jv-footer .footer-bottom {font-size:12px}\n.jv-footer .footer-bottom a,.jv-footer .footer-bottom p {margin-bottom:12px}\n.jv-footer .footer-contact {font-size:14px;font-weight:300;padding:60px 0}\n.jv-footer .footer-contact a {text-decoration:none}\n.jv-footer .footer-contact address {font-size:16px;margin-bottom:24px;padding:0}\n.jv-footer .footer-contact address h6 {font-size:17px;font-weight:300;margin:0}\n.jv-footer .footer-contact .column {-webkit-box-flex:1;-ms-flex:1 1 100%;flex:1 1 100%;max-width:100%}\n@media (min-width:640px) {\n.jv-footer .footer-contact .column:nth-of-type(2),.jv-footer .footer-contact .column:nth-of-type(3) {-webkit-box-flex:1;-ms-flex:1 1 50%;flex:1 1 50%}}\n@media (min-width:1024px) {\n.jv-footer .footer-contact .column {-webkit-box-flex:1;-ms-flex:1 1 33.33333333%;flex:1 1 33.33333333%;max-width:33.33333333%}}\n.jv-footer .footer-contact .column ul {list-style:none;padding-left:0;margin-top:0;margin-bottom:24px}\n.jv-footer .footer-contact .column ul li a {text-decoration:none}\n@media (min-width:640px) {\n.jv-footer .footer-contact .social-links {-webkit-box-pack:end;-ms-flex-pack:end;justify-content:flex-end}}\n.jv-footer .footer-contact .social-links li {margin-right:12px}\n.jv-footer .footer-contact .social-links li a {display:-webkit-box;display:-ms-flexbox;display:flex;min-width:0;min-height:0;-webkit-box-orient:horizontal;-webkit-box-direction:normal;-ms-flex-direction:row;flex-direction:row;-webkit-box-align:center;-ms-flex-align:center;align-items:center;-webkit-box-pack:center;-ms-flex-pack:center;justify-content:center;background-color:#1c8480;border-radius:50%;height:36px;line-height:36px;width:36px}\n.jv-footer .footer-contact .social-links li a svg {width:18px;height:auto}\n.jv-footer .footer-contact .social-links li a svg path {fill:#fff}\n/*! Ben's Updates - 2024_05_03 */\n.jv-page-content:after {background:0 0}\n.banner-text h1 {font-size:2.5em}\n.jv-nav {background-color:#fff;height:calc(100vh - 95px);padding-bottom:9px;padding-top:0;right:auto;top:calc(-100vh + 95px);-webkit-transform:translate3d(0,-100vh,0) scale3d(1,1,1)!important;transform:translate3d(0,-100vh,0) scale3d(1,1,1)!important;width:100vw}\n.jv-nav-visible .jv-nav {-webkit-box-shadow:none;box-shadow:none;-webkit-transform:translate3d(0,100vh,0) scale3d(1,1,1)!important;transform:translate3d(0,100vh,0) scale3d(1,1,1)!important}\n.jv-nav .jv-nav-items {padding:1em .9375rem 0}\n.jv-nav .jv-nav-link {display:block;font-size:14px;font-weight:400;line-height:70px;padding:0;text-transform:capitalize}\n/*!  Mai's CSS */\n#search .u-text-center {margin-top:20px;margin-bottom:0}</style>\n\n    </head>\n    <body class=\"jv-desktop jv-page-search \" ng-app=\"jv.careersite.desktop.app\" ng-controller=\"JVMain\">\n            <div class=\"jv-page-container\" :class=\"{'active': menuOpen }\" x-data=\"{\n        menuOpen:false,\n    }\">\n        <div class=\"jv-page\">\n                <div class=\"jv-page-content\">\n            <header class=\"jv-page-header fixed-header\" role=\"banner\">\n        <div class=\"jv-wrapper flex-row flex-c-center flex-m-space-between\">\n            <div class=\"jv-logo\">\n                <a href=\"https://www.evergreenhealth.com/careers/\">\n                    <img src=\"//careers.jobvite.com/evergreenhealth/logo-2024.png\" alt=\"\" />\n                    <span  class=\"sr-only\">\nEvergreenHealth Careers                    </span>\n                </a>\n            </div>\n            <nav class=\"hide-for-mobile\">\n                <ul class=\"m0 list-unstyled flex-row flex-m-end\">\n                    <li>\n                        <a href=\"/evergreenhealth/jobs/alljobs\">Search Jobs</a>\n                    </li>\n                    <li>\n                        <a href=\"https://www.evergreenhealth.com/careers/\">Careers</a>\n                    </li>\n                    <li>\n                        <a href=\"https://app.jobvite.com/info/register.aspx\">Candidate Portal</a>\n                    </li>\n                    <li>\n                        <a href=\"https://www.evergreenhealth.com/careers/employee-benefits/\">Employee Benefits</a>\n                    </li>\n                </ul>\n            </nav>\n            <div id=\"mobile-toggle\" class=\"flex-row flex-center hide-for-desktop\" @click=\"menuOpen = !menuOpen\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"><!--!Font Awesome Free 6.5.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.--><path d=\"M0 96C0 78.3 14.3 64 32 64H416c17.7 0 32 14.3 32 32s-14.3 32-32 32H32C14.3 128 0 113.7 0 96zM0 256c0-17.7 14.3-32 32-32H416c17.7 0 32 14.3 32 32s-14.3 32-32 32H32c-17.7 0-32-14.3-32-32zM448 416c0 17.7-14.3 32-32 32H32c-17.7 0-32-14.3-32-32s14.3-32 32-32H416c17.7 0 32 14.3 32 32z\"/></svg>\n            </div>\n        </div>\n        <nav class=\"hide-for-desktop\">\n            <ul class=\"m0 list-unstyled flex-col flex-m-start flex-c-start\">\n                <li>\n                    <a href=\"/evergreenhealth/jobs/alljobs\">Search Jobs</a>\n                </li>\n                <li>\n                    <a href=\"https://www.evergreenhealth.com/careers/\">Careers</a>\n                </li>\n                <li>\n                    <a href=\"https://app.jobvite.com/info/register.aspx\">Candidate Portal</a>\n                </li>\n                <li>\n                    <a href=\"https://www.evergreenhealth.com/careers/employee-benefits/\">Employee Benefits</a>\n                </li>\n            </ul>\n        </nav>\n    </header>\n\n\n\n\n\n\n\n\n\n\n    \n    <article class=\"jv-page-body\" role=\"main\" >\n                        <div id=\"search\">\n            <div class=\"section\">\n                <div class=\"jv-wrapper\">\n        <form class=\"jv-search-form jv-form jv-form-inline-md flex-c-center\" action=\"/evergreenhealth/search\" method=\"get\" ng-controller=\"facetedSearchController\">\n                    <div class=\"jv-form-field jv-form-field-select\">\n            <label for=\"jv-search-location\" class=\"jv-form-field-label sr-only\">Location:</label>\n            <div class=\"jv-form-field-control\" ng-class=\"{ 'jv-form-field-appearance': supportsAppearance }\">\n                <i ng-if=\"supportsAppearance\" ng-cloak class=\"jv-select-icon icon icon-arrow-down\"></i>\n                    <select id=\"jv-search-location\" name=\"l\" ng-model=\"state.selectedFacets['l']\" ng-disabled=\"!state.facets['l'] || state.loading\">\n                <option value=\"\">Location</option>\n                    <option ng-repeat=\"item in state.facets['l']\" value=\"{{ item.name }}\">{{ item.name }}</option>\n                </select>\n            </div>\n        </div>\n        <div class=\"jv-form-field jv-form-field-select\">\n            <label for=\"jv-search-category\" class=\"jv-form-field-label sr-only\">Category:</label>\n            <div class=\"jv-form-field-control\" ng-class=\"{ 'jv-form-field-appearance': supportsAppearance }\">\n                <i ng-if=\"supportsAppearance\" ng-cloak class=\"jv-select-icon icon icon-arrow-down\"></i>\n                    <select id=\"jv-search-category\" name=\"c\" ng-model=\"state.selectedFacets['c']\" ng-disabled=\"!state.facets['c'] || state.loading\">\n                <option value=\"\">Job Category</option>\n                    <option ng-repeat=\"item in state.facets['c']\" value=\"{{ item.name }}\">{{ item.name }}</option>\n                </select>\n            </div>\n        </div>\n                                <div class=\"jv-form-field jv-form-field-select\">\n            <label for=\"jv-search-type\" class=\"jv-form-field-label sr-only\">Job Type:</label>\n            <div class=\"jv-form-field-control\" ng-class=\"{ 'jv-form-field-appearance': supportsAppearance }\">\n                <i ng-if=\"supportsAppearance\" ng-cloak class=\"jv-select-icon icon icon-arrow-down\"></i>\n                    <select id=\"jv-search-type\" name=\"t\" ng-model=\"state.selectedFacets['t']\" ng-disabled=\"!state.facets['t'] || state.loading\">\n                <option value=\"\">Job Type</option>\n                    <option ng-repeat=\"item in state.facets['t']\" value=\"{{ item.name }}\">{{ item.name }}</option>\n                </select>\n            </div>\n        </div>\n            \n                        <div class=\"jv-form-field jv-search-field\">\n\n                <label for=\"jv-search-keyword\" class=\"jv-form-field-label sr-only\">Keyword:</label>\n                \n                            <div class=\"jv-form-field-control\">\n\n                                        <input id=\"jv-search-keyword\" class=\"jv-search-input\" type=\"search\" name=\"q\" ng-non-bindable placeholder=\"What are you interested in?\" value=\"\" ng-model=\"state.keyword\" />\n                </div>\n            </div>\n                            \n                            <div class=\"jv-form-buttons\">\n                        <button class=\"jv-button jv-button-primary\" type=\"submit\"><i class=\"icon icon-search\"></i><span class=\"sr-only\">Search</span></button>\n            <a href=\"/evergreenhealth/jobs/alljobs\" class=\"jv-button jv-button-primary\">View all jobs</a>\n        </div>\n        </form>\n                </div>\n            </div>\n        </div>\n        <div class=\"jv-wrapper py2\">\n        \n                    <div class=\"jv-job-list jv-search-list\">\n                <ul class=\"list-unstyled\">\n    \n                <li class=\"row\">\n            <a href=\"/evergreenhealth/job/oX1LAfw3\" class=\"flex-row flex-c-center\">\n                <div class=\"flex-col\">\n                    <div class=\"jv-job-list-name\">\n                        Acute Care Neurosurgeon\n                    </div>\n                    <div class=\"ml-auto jv-job-list-location\">\n\n        \n            Kirkland,\n            Washington\n        \n  | Department: Neurosurgical Care - Provider   | Job Type: Full-Time  | \n                    </div>\n                </div>\n                <div class=\"ml-auto\">\n                    <i class=\"fas fa-2x fa-chevron-right\"></i>\n                </div>\n            </a>\n        </li>\n\n    \n                <li class=\"row\">\n            <a href=\"/evergreenhealth/job/obp5zfwY\" class=\"flex-row flex-c-center\">\n                <div class=\"flex-col\">\n                    <div class=\"jv-job-list-name\">\n                        Anesthesia Technician (1.0 FTE)\n                    </div>\n                    <div class=\"ml-auto jv-job-list-location\">\n\n        \n            Kirkland,\n            Washington\n        \n  | Department: Anesthesiology   | Job Type: Full-Time  | \n                    </div>\n                </div>\n                <div class=\"ml-auto\">\n                    <i class=\"fas fa-2x fa-chevron-right\"></i>\n                </div>\n            </a>\n        </li>\n\n    \n                <li class=\"row\">\n            <a href=\"/evergreenhealth/job/oLwxAfw8\" class=\"flex-row flex-c-center\">\n                <div class=\"fle
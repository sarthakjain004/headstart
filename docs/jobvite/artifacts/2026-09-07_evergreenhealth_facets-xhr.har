ocusable:active,.sr-only-focusable:focus {position:static;width:auto;height:auto;overflow:visible;clip:auto;white-space:normal;-webkit-clip-path:none;clip-path:none}\n.list-unstyled {list-style:none;padding-left:0}\n.u-text-center {text-align:center}\n.u-text-left {text-align:left}\n.u-text-right {text-align:right}\n.r-img {border:0;max-width:100%;height:auto}\n.d-hide {display:none}\n.u-float-left {float:left}\n#footer-jobalerts {margin-top:30px}\n/*! Revisions for Evergreen Health */\n/*! Ben's Updates - 2024_02_28 */\n.jv-button.jv-button-primary:hover {background-color:#454849}\n.section#videos {padding-top:0}\n.section#videos .row {display:-webkit-box;display:-ms-flexbox;display:flex;min-width:0;min-height:0;-webkit-box-orient:vertical;-webkit-box-direction:normal;-ms-flex-direction:column;flex-direction:column;-webkit-box-align:center;-ms-flex-align:center;align-items:center;-webkit-box-pack:center;-ms-flex-pack:center;justify-content:center}\n@media (min-width:768px) {\n.section#videos .row {display:-webkit-box;display:-ms-flexbox;display:flex;min-width:0;min-height:0;-webkit-box-orient:horizontal;-webkit-box-direction:normal;-ms-flex-direction:row;flex-direction:row}}\n.video-container {margin:1rem 0;max-height:100%;width:clamp(400px,100%,800px)}\n.video-container embed,.video-container iframe,.video-container object {aspect-ratio:16/9;width:100%;height:100%}\n/*! Ben's Updates - 2024_05_02 */\nbody {-webkit-font-smoothing:antialiased}\nbody.active {overflow-y:hidden}\n.jv-page-content {padding-top:95px}\n.jv-page-header {height:auto;padding:10px 0;z-index:1000}\n.jv-page-header .jv-wrapper {padding:0 .9375rem}\n.jv-page-header .jv-wrapper:after {content:none}\n.jv-page-header nav {border-top:none}\n.jv-page-header nav a {font-size:14px;font-weight:400;line-height:70px}\n.jv-page-header nav a,.jv-page-header nav a:hover {color:#485c69}\n.jv-page-header #mobile-toggle {width:18px;height:18px}\n.jv-page-header #mobile-toggle svg {width:100%;height:100%}\n.jv-page-header nav.hide-for-desktop {background-color:#fff;height:0;left:0;opacity:0;padding:0 .9375rem;position:absolute;top:85px;-webkit-transition:height .3s ease-in-out;transition:height .3s ease-in-out;visibility:hidden;width:100%;z-index:501}\n.jv-page-container.active .jv-page-header nav.hide-for-desktop {height:calc(100vh - 85px);opacity:1;visibility:visible}\n.jv-page-header nav.hide-for-desktop ul {padding:0 .9375rem}\n.jv-page-header nav.hide-for-desktop ul li a {color:#333;display:block;padding:0}\n.hide-for-desktop {display:block}\n@media (min-width:1024px) {\n.hide-for-desktop {display:none}}\n.hide-for-mobile {display:none}\n@media (min-width:1024px) {\n.hide-for-mobile {display:block}}\n.jv-logo {margin-bottom:0}\n.jv-logo a img {width:auto;height:100%;max-height:70px}\n.jv-footer .footer-bottom {font-size:12px}\n.jv-footer .footer-bottom a,.jv-footer .footer-bottom p {margin-bottom:12px}\n.jv-footer .footer-contact {font-size:14px;font-weight:300;padding:60px 0}\n.jv-footer .footer-contact a {text-decoration:none}\n.jv-footer .footer-contact address {font-size:16px;margin-bottom:24px;padding:0}\n.jv-footer .footer-contact address h6 {font-size:17px;font-weight:300;margin:0}\n.jv-footer .footer-contact .column {-webkit-box-flex:1;-ms-flex:1 1 100%;flex:1 1 100%;max-width:100%}\n@media (min-width:640px) {\n.jv-footer .footer-contact .column:nth-of-type(2),.jv-footer .footer-contact .column:nth-of-type(3) {-webkit-box-flex:1;-ms-flex:1 1 50%;flex:1 1 50%}}\n@media (min-width:1024px) {\n.jv-footer .footer-contact .column {-webkit-box-flex:1;-ms-flex:1 1 33.33333333%;flex:1 1 33.33333333%;max-width:33.33333333%}}\n.jv-footer .footer-contact .column ul {list-style:none;padding-left:0;margin-top:0;margin-bottom:24px}\n.jv-footer .footer-contact .column ul li a {text-decoration:none}\n@media (min-width:640px) {\n.jv-footer .footer-contact .social-links {-webkit-box-pack:end;-ms-flex-pack:end;justify-content:flex-end}}\n.jv-footer .footer-contact .social-links li {margin-right:12px}\n.jv-footer .footer-contact .social-links li a {display:-webkit-box;display:-ms-flexbox;display:flex;min-width:0;min-height:0;-webkit-box-orient:horizontal;-webkit-box-direction:normal;-ms-flex-direction:row;flex-direction:row;-webkit-box-align:center;-ms-flex-align:center;align-items:center;-webkit-box-pack:center;-ms-flex-pack:center;justify-content:center;background-color:#1c8480;border-radius:50%;height:36px;line-height:36px;width:36px}\n.jv-footer .footer-contact .social-links li a svg {width:18px;height:auto}\n.jv-footer .footer-contact .social-links li a svg path {fill:#fff}\n/*! Ben's Updates - 2024_05_03 */\n.jv-page-content:after {background:0 0}\n.banner-text h1 {font-size:2.5em}\n.jv-nav {background-color:#fff;height:calc(100vh - 95px);padding-bottom:9px;padding-top:0;right:auto;top:calc(-100vh + 95px);-webkit-transform:translate3d(0,-100vh,0) scale3d(1,1,1)!important;transform:translate3d(0,-100vh,0) scale3d(1,1,1)!important;width:100vw}\n.jv-nav-visible .jv-nav {-webkit-box-shadow:none;box-shadow:none;-webkit-transform:translate3d(0,100vh,0) scale3d(1,1,1)!important;transform:translate3d(0,100vh,0) scale3d(1,1,1)!important}\n.jv-nav .jv-nav-items {padding:1em .9375rem 0}\n.jv-nav .jv-nav-link {display:block;font-size:14px;font-weight:400;line-height:70px;padding:0;text-transform:capitalize}\n/*!  Mai's CSS */\n#search .u-text-center {margin-top:20px;margin-bottom:0}</style>\n\n    </head>\n    <body class=\"jv-desktop jv-page-jobs \" ng-app=\"jv.careersite.desktop.app\" ng-controller=\"JVMain\">\n            <div class=\"jv-page-container\" :class=\"{'active': menuOpen }\" x-data=\"{\n        menuOpen:false,\n    }\">\n        <div class=\"jv-page\">\n                <div class=\"jv-page-content\">\n            <header class=\"jv-page-header fixed-header\" role=\"banner\">\n        <div class=\"jv-wrapper flex-row flex-c-center flex-m-space-between\">\n            <div class=\"jv-logo\">\n                <a href=\"https://www.evergreenhealth.com/careers/\">\n                    <img src=\"//careers.jobvite.com/evergreenhealth/logo-2024.png\" alt=\"\" />\n                    <span  class=\"sr-only\">\nEvergreenHealth Careers                    </span>\n                </a>\n            </div>\n            <nav class=\"hide-for-mobile\">\n                <ul class=\"m0 list-unstyled flex-row flex-m-end\">\n                    <li>\n                        <a href=\"/evergreenhealth/jobs/alljobs\">Search Jobs</a>\n                    </li>\n                    <li>\n                        <a href=\"https://www.evergreenhealth.com/careers/\">Careers</a>\n                    </li>\n                    <li>\n                        <a href=\"https://app.jobvite.com/info/register.aspx\">Candidate Portal</a>\n                    </li>\n                    <li>\n                        <a href=\"https://www.evergreenhealth.com/careers/employee-benefits/\">Employee Benefits</a>\n                    </li>\n                </ul>\n            </nav>\n            <div id=\"mobile-toggle\" class=\"flex-row flex-center hide-for-desktop\" @click=\"menuOpen = !menuOpen\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"><!--!Font Awesome Free 6.5.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.--><path d=\"M0 96C0 78.3 14.3 64 32 64H416c17.7 0 32 14.3 32 32s-14.3 32-32 32H32C14.3 128 0 113.7 0 96zM0 256c0-17.7 14.3-32 32-32H416c17.7 0 32 14.3 32 32s-14.3 32-32 32H32c-17.7 0-32-14.3-32-32zM448 416c0 17.7-14.3 32-32 32H32c-17.7 0-32-14.3-32-32s14.3-32 32-32H416c17.7 0 32 14.3 32 32z\"/></svg>\n            </div>\n        </div>\n        <nav class=\"hide-for-desktop\">\n            <ul class=\"m0 list-unstyled flex-col flex-m-start flex-c-start\">\n                <li>\n                    <a href=\"/evergreenhealth/jobs/alljobs\">Search Jobs</a>\n                </li>\n                <li>\n                    <a href=\"https://www.evergreenhealth.com/careers/\">Careers</a>\n                </li>\n                <li>\n                    <a href=\"https://app.jobvite.com/info/register.aspx\">Candidate Portal</a>\n                </li>\n                <li>\n                    <a href=\"https://www.evergreenhealth.com/careers/employee-benefits/\">Employee Benefits</a>\n                </li>\n            </ul>\n        </nav>\n    </header>\n\n\n\n\n\n\n    \n            \n    <article class=\"jv-page-body\" role=\"main\" >\n                                                           \n    \n    \n            <div x-data=\"{isHidden: true}\">\n        <div id=\"search-fixed\" \n            class=\"is-hidden\"\n            :class=\"{'is-hidden':isHidden === true}\"\n            x-on:toggle.window='isHidden = !isHidden'>\n            <div class=\"section\">\n                <div class=\"jv-wrapper\">\n        <form class=\"jv-search-form jv-form jv-form-inline-md flex-c-center\" action=\"/evergreenhealth/search\" method=\"get\" ng-controller=\"facetedSearchController\">\n                    <div class=\"jv-form-field jv-form-field-select\">\n            <label for=\"jv-search-location\" class=\"jv-form-field-label sr-only\">Location:</label>\n            <div class=\"jv-form-field-control\" ng-class=\"{ 'jv-form-field-appearance': supportsAppearance }\">\n                <i ng-if=\"supportsAppearance\" ng-cloak class=\"jv-select-icon icon icon-arrow-down\"></i>\n                    <select id=\"jv-search-location\" name=\"l\" ng-model=\"state.selectedFacets['l']\" ng-disabled=\"!state.facets['l'] || state.loading\">\n                <option value=\"\">Location</option>\n                    <option ng-repeat=\"item in state.facets['l']\" value=\"{{ item.name }}\">{{ item.name }}</option>\n                </select>\n            </div>\n        </div>\n        <div class=\"jv-form-field jv-form-field-select\">\n            <label for=\"jv-search-category\" class=\"jv-form-field-label sr-only\">Category:</label>\n            <div class=\"jv-form-field-control\" ng-class=\"{ 'jv-form-field-appearance': supportsAppearance }\">\n                <i ng-if=\"supportsAppearance\" ng-cloak class=\"jv-select-icon icon icon-arrow-down\"></i>\n                    <select id=\"jv-search-category\" name=\"c\" ng-model=\"state.selectedFacets['c']\" ng-disabled=\"!state.facets['c'] || state.loading\">\n                <option value=\"\">Job Category</option>\n                    <option ng-repeat=\"item in state.facets['c']\" value=\"{{ item.name }}\">{{ item.name }}</option>\n                </select>\n            </div>\n        </div>\n                                <div class=\"jv-form-field jv-form-field-select\">\n            <label for=\"jv-search-type\" class=\"jv-form-field-label sr-only\">Job Type:</label>\n            <div class=\"jv-form-field-control\" ng-class=\"{ 'jv-form-field-appearance': supportsAppearance }\">\n                <i ng-if=\"supportsAppearance\" ng-cloak class=\"jv-select-icon icon icon-arrow-down\"></i>\n                    <select id=\"jv-search-type\" name=\"t\" ng-model=\"state.selectedFacets['t']\" ng-disabled=\"!state.facets['t'] || state.loading\">\n                <option value=\"\">Job Type</option>\n                    <option ng-repeat=\"item in state.facets['t']\" value=\"{{ item.name }}\">{{ item.name }}</option>\n                </select>\n            </div>\n        </div>\n            \n                        <div class=\"jv-form-field jv-search-field\">\n\n                <label for=\"jv-search-keyword\" class=\"jv-form-field-label sr-only\">Keyword:</label>\n                \n                            <div class=\"jv-form-field-control\">\n\n                                        <input id=\"jv-search-keyword\" class=\"jv-search-input\" type=\"search\" name=\"q\" ng-non-bindable placeholder=\"What are you interested in?\" value=\"\" ng-model=\"state.keyword\" />\n                </div>\n            </div>\n                            \n                            <div class=\"jv-form-buttons\">\n                        <button class=\"jv-button jv-button-primary\" type=\"submit\"><i class=\"icon icon-search\"></i><span class=\"sr-only\">Search</span></button>\n            <a href=\"/evergreenhealth/jobs/alljobs\" class=\"jv-button jv-button-primary\">View all jobs</a>\n        </div>\n        </form>\n                    <div class=\"btn-show-hide\" role=\"button\" tab-index=\"0\" @click=\"$dispatch('toggle')\" :class=\"{'is-visible':isHidden===false}\"><i class=\"fas fa-chevron-down mr-5\"></i><span :class=\"{'d-hide':isHidden===false}\">Show Search</span><span :class=\"{'d-hide':isHidden===true}\">Hide Search</span></div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div id=\"banner\" class=\"banner banner-home\">\n        <div class=\"slides\">\n            <div class=\"slide slide-1\"></div>\n                                            </div>\n        <div class=\"overlay flex-col flex-m-end pb2\">\n            <div class=\"jv-wrapper overlay-text flex-col flex-center\">\n                <h1>Careers at EvergreenHealth</h1>\n            </div>\n        </div>\n    </div>\n    <div id=\"search\">\n        <div class=\"section\">\n            <div class=\"jv-wrapper\">\n        <form class=\"jv-search-form jv-form jv-form-inline-md flex-c-center\" action=\"/evergreenhealth/search\" method=\"get\" ng-controller=\"facetedSearchController\">\n                    <div class=\"jv-form-field jv-form-field-select\">\n            <label for=\"jv-search-location\" class=\"jv-form-field-label sr-only\">Location:</label>\n            <div class=\"jv-form-field-control\" ng-class=\"{ 'jv-form-field-appearance': supportsAppearance }\">\n                <i ng-if=\"supportsAppearance\" ng-cloak class=\"jv-select-icon icon icon-arrow-down\"></i>\n                    <select id=\"jv-search-location\" name=\"l\" ng-model=\"state.selectedFacets['l']\" ng-disabled=\"!state.facets['l'] || state.loading\">\n                <option value=\"\">Location</option>\n                    <option ng-repeat=\"item in state.facets['l']\" value=\"{{ item.name }}\">{{ item.name }}</option>\n                </select>\n            </div>\n        </div>\n        <div class=\"jv-form-field jv-form-field-select\">\n            <label for=\"jv-search-category\" class=\"jv-form-field-label sr-only\">Category:</label>\n            <div class=\"jv-form-field-control\" ng-class=\"{ 'jv-form-field-appearance': supportsAppearance }\">\n                <i ng-if=\"supportsAppearance\" ng-cloak class=\"jv-select-icon icon icon-arrow-down\"></i>\n                    <select id=\"jv-search-category\" name=\"c\" ng-model=\"state.selectedFacets['c']\" ng-disabled=\"!state.facets['c'] || state.loading\">\n                <option value=\"\">Job Category</option>\n                    <option ng-repeat=\"item in state.facets['c']\" value=\"{{ item.name }}\">{{ item.name }}</option>\n                </select>\n            </div>\n        </div>\n                                <div class=\"jv-form-field jv-form-field-select\">\n            <label for=\"jv-search-type\" class=\"jv-form-field-label sr-only\">Job Type:</label>\n            <div class=\"jv-form-field-control\" ng-class=\"{ 'jv-form-field-appearance': supportsAppearance }\">\n                <i ng-if=\"supportsAppearance\" ng-cloak class=\"jv-select-icon icon icon-arrow-down\"></i>\n                    <select id=\"jv-search-type\" name=\"t\" ng-model=\"state.selectedFacets['t']\" ng-disabled=\"!state.facets['t'] || state.loading\">\n                <option value=\"\">Job Type</option>\n                    <option ng-repeat=\"item in state.facets['t']\" value=\"{{ item.name }}\">{{ item.name }}</option>\n                </select>\n            </div>\n        </div>\n            \n                        <div class=\"jv-form-field jv-search-field\">\n\n                <label for=\"jv-search-keyword\" class=\"jv-form-field-label sr-only\">Keyword:</label>\n                \n                            <div class=\"jv-form-field-control\">\n\n                                        <input id=\"jv-search-keyword\" class=\"jv-search-input\" type=\"search\" name=\"q\" ng-non-bindable placeholder=\"What are you interested in?\" value=\"\" ng-model=\"state.keyword\" />\n                </div>\n            </div>\n                            \n                            <div class=\"jv-form-buttons\">\n                        <button class=\"jv-button jv-button-primary\" type=\"submit\"><i class=\"icon icon-search\"></i><span class=\"sr-only\">Search</span></button>\n            <a href=\"/evergreenhealth/jobs/alljobs\" class=\"jv-button jv-button-primary\">View all jobs</a>\n        </div>\n        </form>\n                <p class=\"u-text-center\"><a href=\"/evergreenhealth/jobAlerts\" class=\"jv-button jv-button-primary \">Sign-up for Job Alerts</a></p>\n            </div>\n        </div>\n    </div>\n    <section id=\"about\">\n        <div class=\"section\">\n            <div class=\"jv-wrapper\">\n                <h2 class=\"u-text-center\">About EvergreenHealth</h2>\n                <p>EvergreenHealth is an integrated community-owned healthcare system offering an immense, breadth of services and programs that are among the most comprehensive in the region.</p>\n                <p>Serving nearly 1 million residents across the Puget Sound area, EvergreenHealth offers you state-of-the-art facilities and a collaborative network of providers and experts working hand-in-hand with you to provide your patients the best care possible. </p>\n                <p>Recognized by Healthgrades as one of America's 50 Best Hospitals and by The Leapfrog Group with an A grade for Patient Safety, you\u2019ll join a high-level team that understands your autonomy and knows how a healthy work-life balance leads to the best results for you and your work.</p>\n                <p>Plus, you\u2019ll be immersed in the most beautiful part of the Puget Sound region, with every type of amenity within a 30-minute drive. Whether you and your loved ones are into hiking, snowboarding, kayaking or you simply enjoy trying the latest restaurant, EvergreenHealth puts you just minutes away from everything the Pacific Northwest has to offer.</p>\n                <p>EvergreenHealth\u2019s second-to-none culture is supported not only by our specialized and compassionate staff, but it is bolstered by our diverse patient population. Our community includes programmers, engineers, scientists and families who benefit from the thriving environmental and technological industries in and around the EvergreenHealth area. </p>\n                <p>Join EvergreenHealth and become a part of the most exciting and respected healthcare staples not only in Washington state but throughout the entire nation.</p>\n            \n                <p><strong>Diversity, Equity & Inclusion</strong><br />EvergreenHealth is an Equal Opportunity Employer. All employment practices shall be free from discrimination; all facilities shall be accessible and usable by disabled persons. All decisions involving any aspect of the employment relationship are made without regard to race, color, sex, religion, age, national origin, marital or military status, sexual orientation, gender identity, the presence of any sensory, mental, or physical disability, genetic information or any other status or characteristic protected by local, state or federal law. Discrimination and/or harassment based on any of those factors contradicts EvergreenHealth's philosophy of doing business and will not be tolerated. </p>\n                <p><strong>EvergreenHealth\u2019s Diversity, Equity and Inclusion Council (DEIC)</strong><br />Diversity is the range of human differences, including but not limited to race, ethnicity, gender, gender identity, sexual orientation, age, social class, physical ability or attributes, religious or ethical values system, national origin and political beliefs. EvergreenHealth\u2019s DEIC is a group of staff members and physicians who seek to elevate and promote a culture of equity, inclusion and diversity throughout the EvergreenHealth system.</p>\n                <p><strong>Diversity, Equity and Inclusion Value Statement</strong><br />EvergreenHealth is a Public District Hospital whose organizational purpose is to \u201cenrich the health and well-being of every life we touch.\u201d <strong>Our people</strong> share a deep commitment to providing exceptional care and service for each one of our patients, and one another.</p>\n                <p>We are seeking people who will contribute to and support our culture of equity, inclusion and belonging, while acknowledging health disparities and actively supporting the health of vulnerable communities. Are you excited about contributing to our organization\u2019s diverse community of care? Please join us!</p>\n                \n            </div>\n        </div>\n        <div class=\"section\" id=\"videos\">\n            <div class=\"jv-wrapper\">\n                <div class=\"row flex-row flex-m-space-around flex-c-center flex-wrap\">\n                    <h3 class=\"u-text-center\">Welcome Message to Prospective Candidates <br />from Dr. Ettore Palazzo, MD, FACP \u2013 CEO.</h3>\n                    <div class=\"video-container\">\n                                                <iframe src=\"https://www.youtube.com/embed/SAhjPgs23aM?si=k3r1MiMEc-kN7tB6\" title=\"YouTube video player\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen></iframe>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <section>\n        <div class=\"section section-light\">\n            <div class=\"jv-wrapper u-text-center\">\n                <h2>Working At EvergreenHealth</h2>\n                <p>It takes quality people to deliver quality patient care.</p>\n                <h4 class=\"highlight mb1\">COMPASSION | RESPECT | EXCELLENCE | COLLABORATION | ACCOUNTABILITY</h4>\n                <p>Our values are reflected in our culture and our EvergreenHealth family has some of the most caring, compassionate, and committed people in the Northwest.</p>\n            </div>\n        </div>\n    </section>\n                                                                                                                                                                                                                                                <section id=\"perks\">\n        <div class=\"section\">\n            <div class=\"jv-wrapper\">\n                <h2 class=\"u-text-center\">EvergreenHealth Perks</h2>\n                <p class=\"u-text-center\"><strong>Be Your Best Self</strong>&#8212;When you\u2019re working your hardest to make a difference, you need support. At EvergreenHealth we offer:</p>\n                <div id=\"flip-grid\" class=\"flex-col flex-c-center flex-row-sm flex-wrap-sm flex-m-center-sm flex-c-stretch-sm\" x-data=\"{ isOpen: '' }\">\n    <div class=\"flip-container\" :class=\"{'active':isOpen === 'flip-1'}\">\n        <div class=\"flipper\">\n            <div class=\"front flex-col flex-m-end icon-healthy\" @click=\"isOpen = 'flip-1'\">\n                <h1 class=\"title\">Keeping You Healthy</h1>\n            </div>\n            <div class=\"back flex-col flex-m-center\" @click=\"isOpen = ''\">\n                <h2>Keeping You Healthy</h2>\n                <ul>\n                    <li>Medical Plans</li>\n                    <li>Dental Plan</li>\n                    <li>Vision Plan</li>\n                    <li>98point6 On-Demand Health Care</li>\n                    <li>Prescription Drug Coverage</li>\n                    <li>Evergreen Professional Center Pharmacy Discounts</li>\n                    <li>Healthcare Spending Account</li>\n                    <li>Employee Assistance Program</li>\n                    <li>Flu vaccine</li>\n                    <li>Discounted fitness club memberships</li>\n                    <li>Tobacco Cessation</li>\n                </ul>\n            </div>\n        </div>\n    </div>\n    \n    <div class=\"flip-container\" :class=\"{'active':isOpen === 'flip-2'}\">\n        <div class=\"flipper\">\n            <div class=\"front flex-col flex-m-end icon-balance\" @click=\"isOpen = 'flip-2'\">\n                <h1 class=\"title\">Work-Life Balance</h1>\n            </div>\n            <div class=\"back flex-col flex-m-center\" @click=\"isOpen = ''\">\n                <h2>Work-Life Balance</h2>\n                <ul>\n                    <li>Generous PTO with rollover</li>\n                    <li>Paid holidays</li>\n                    <li>Travel Assistance Services</li>\n                    <li>Hotel discounts</li>\n                    <li>Discounted movie tickets</li>\n                    <li>Discounted lift tickets</li>\n                    <li>Retail discounts</li>\n                </ul>\n            </div>\n        </div>\n    </div>\n    \n    <div class=\"flip-container\" :class=\"{'active':isOpen === 'flip-3'}\">\n        <div class=\"flipper\">\n            <div class=\"front flex-col flex-m-end icon-transportation\" @click=\"isOpen = 'flip-3'\">\n                <h1 class=\"title\">Transportation</h1>\n            </div>\n            <div class=\"back flex-col flex-m-center\" @click=\"isOpen = ''\">\n                <h2>Transportation</h2>\n                <ul>\n                    <li>Free Parking</li>\n                    <li>Discounted Orca Pass</li>\n                    <li>Commuter Incentive Program</li>\n                    <li>EV Charging Stations</li>\n                </ul>\n            </div>\n        </div>\n    </div>\n    \n    <div class=\"flip-container\" :class=\"{'active':isOpen === 'flip-4'}\">\n        <div class=\"flipper\">\n            <div class=\"front flex-col flex-m-end icon-planning\" @click=\"isOpen = 'flip-4'\">\n                <h1 class=\"title\">Future Planning</h1>\n            </div>\n            <div class=\"back flex-col flex-m-center\" @click=\"isOpen = ''\">\n                <h2>Future Planning</h2>\n                <ul>\n                    <li>Life Insurance</li>\n                    <li>Long Term Disability</li>\n                    <li>Short Term Disability</li>\n                    <li>Retirement Plans</li>\n                    <li>Dependent Care Spending Account</li>\n                    <li>Deferred Compensation Plan 457(b)</li>\n                    <li>Employer Match 401(a)</li>\n                    <li>Employer Base 401(a) Contribution</li>\n                </ul>\n            </div>\n        </div>\n    </div>\n    \n    <div class=\"flip-container\" :class=\"{'active':isOpen === 'flip-5'}\">\n        <div class=\"flipper\">\n            <div class=\"front flex-col flex-m-end icon-development\" @click=\"isOpen = 'flip-5'\">\n                <h1 class=\"title\">Professional Development</h1>\n            </div>\n            <div class=\"back flex-col flex-m-center\" @click=\"isOpen = ''\">\n                <h2>Professional Development</h2>\n                <ul>\n                    <li>Tuition Reimbursement Program</li>\n                    <li>Continuing Education</li>\n                    <li>Nursing Student Program</li>\n                </ul>\n            </div>\n        </div>\n    </div>\n    \n    <div class=\"flip-container\" :class=\"{'active':isOpen === 'flip-6'}\">\n        <div class=\"flipper\">\n            <div class=\"front flex-col flex-m-end icon-excellence\" @click=\"isOpen = 'flip-6'\">\n                <h1 class=\"title\">Inspiring Excellence</h1>\n            </div>\n            <div class=\"back flex-col flex-m-center\" @click=\"isOpen = ''\">\n                <h2>Inspiring Excellence</h2>\n                <ul>\n                    <li>DAISY Awards</li>\n                    <li>Employee Appreciation Lunches</li>\n                    <li>Quarterly Award Recognition</li>\n                    <li>Employee Engagement Survey</li>\n                </ul>\n            </div>\n        </div>\n    </div>\n</div>\n                <h2 class=\"u-text-center\">Benefits at a Glance</h2>\n                <p class=\"u-text-center\">View a summary of our total rewards available to you as an EvergreenHealth team member by clicking on the link below.</p>\n                <p class=\"u-text-center\"><a href=\"//careers.jobvite.com/evergreenhealth/2024_EvergreenHealth-Interactive-Guide-FINAL.pdf\" class=\"jv-button\" target=\"_blank\">Benefit Guide</a></p>\n            </div>\n        </div>\n    </section>\n                                        <section id=\"awards\">\n        <div class=\"section section-light\">\n            <div class=\"jv-wrapper\">\n                <h2 class=\"u-text-center\">Awards</h2>\n                <div class=\"flex-row flex-wrap flex-center award-list\">\n                    <img src=\"//careers.jobvite.com/evergreenhealth/award-best-50.png\" alt=\"America's best 50 hospitals 2021\">\n                    <img src=\"//careers.jobvite.com/evergreenhealth/award-aha.png\" alt=\"2019 American Heart Association\">\n                                        <img src=\"//careers.jobvite.com/evergreenhealth/award-general.png\" alt=\"The Leap Frog Group, Top General Hospital 2019\">\n                                        <img src=\"//careers.jobvite.com/evergreenhealth/award-cms.png\" alt=\"Five-star top performer, centers for medicare and medicaid services\">\n                </div>\n            </div>\n        </div>\n    </section>\n                                                                                                                                                                                        \n\n    </article>\n\n\n<script>\n    var ready = function ( fn ) {\n        if ( typeof fn !== 'function' ) return;\n        if ( document.readyState === 'complete'  ) {\n            return fn();\n        }\n        document.addEventListener( 'DOMContentLoaded', fn, false );\n    };\n    \n    ready(function() {\n        var homeSlider = tns({\n            container: '.banner-home .slides',\n            controls: false,\n            center: false,\n            nav: false,\n            items: 1,\n            slideBy: 'page',\n            autoplay: true,\n            autoplayButtonOutput: false,\n            autoplayTimeout: 8000,\n            autoplayHoverPause: false,\n            speed: 1000,\n            animateIn: 'fadeIn',\n            animateOut: 'fadeOut',\n            mode: \"gallery\"\n        });\n        \n        var waypointHeader = new Waypoint({\n            //trigger = document.querySelector('#search'), // Element to trigger waypoint when top of browser reaches the element\n            //header = document.querySelector('.sidenav-menu'), // Element to have class toggled on\n            element: document.querySelector('#search'),\n            handler: function(event,direction) {\n                document.querySelector('.jv-page-header').classList.toggle('is-compact');\n            },\n            offset:50, // Trigger number of pixels before element\n        })\n        \n        var waypointSearch = new Waypoint({\n            //trigger = document.querySelector('#search'), // Element to trigger waypoint when top of browser reaches the element\n            //header = document.querySelector('.sidenav-menu'), // Element to have class toggled on\n            element: document.querySelector('#search'),\n            handler: function(event,direction) {\n                document.querySelector('#search-fixed').classList.toggle('is-active');\n            },\n            offset:50, // Trigger number of pixels before element\n        })\n        \n        // Staff Quote\n        var staffSlider = tns({\n            container: \"#staff-quotes .slides\",\n            autoHeight: false,\n            autoWidth: false,\n            arrowKeys: true,\n            controls: true,\n            controlsContainer: \"#staff-controls\",\n            center: false,\n            nav: false,\n            mouseDrag: true,\n            gutter: 0,\n            slideBy: 1,\n            autoplay: true,\n            autoplayButtonOutput: false,\n            autoplayTimeout: 10000,\n            autoplayHoverPause: false,\n            speed: 500\n        });\n\n    });\n</script>\n    <footer class=\"jv-footer\">\n        <div class=\"footer-contact\">\n            <div class=\"jv-wrapper flex-row flex-wrap flex-c-start\">\n                <div class=\"column flex-col flex-c-start\">\n                    <ul>\n                        <li><a href=\"/evergreenhealth/jobs/alljobs\">Search Jobs</a></li>\n                        <li><a href=\"https://www.evergreenhealth.com/careers/\">Careers</a></li>\n                        <li><a href=\"https://app.jobvite.com/info/register.aspx\">Candidate Portal</a></li>\n                        <li><a href=\"https://www.evergreenhealth.com/careers/employee-benefits/\">Employee Benefits</a></li>\n                    </ul>\n                </div>\n                <div class=\"column flex-col flex-c-start\">\n                    <address>\n                        <h6>EvergreenHealth</h6>\n                        <em>12040 NE 128th St.<br>Kirkland, WA</em>\n                        <br>\n                        <br>\n                        <a href=\"+4258991000\">+(425) 899-1000</a><br>\n                        <a href=\"/cdn-cgi/l/email-protection#ea8f8280858899aa8f9c8f988d988f8f84828f8b869e82c4898587\"><span class=\"__cf_email__\" data-cfemail=\"a3c6cbc9ccc1d0e3c6d5c6d1c4d1c6c6cdcbc6c2cfd7cb8dc0ccce\">[email&#160;protected]</span></a>\n                    </address>\n                </div>\n                <div class=\"column\">\n                    <ul class=\"flex-row social-links\">\n                        <li>\n                            <a href=\"https://www.facebook.com/evergreenhospital.org\">\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"><!--!Font Awesome Free 6.5.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.--><path d=\"M512 256C512 114.6 397.4 0 256 0S0 114.6 0 256C0 376 82.7 476.8 194.2 504.5V334.2H141.4V256h52.8V222.3c0-87.1 39.4-127.5 125-127.5c16.2 0 44.2 3.2 55.7 6.4V172c-6-.6-16.5-1-29.6-1c-42 0-58.2 15.9-58.2 57.2V256h83.6l-14.4 78.2H287V510.1C413.8 494.8 512 386.9 512 256h0z\"/></svg>\n                            </a>\n                        </li>\n                        <li>\n                            <a href=\"https://twitter.com/EvergreenHosp\">\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"><!--!Font Awesome Free 6.5.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.--><path d=\"M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8L200.7 275.5 26.8 48H172.4L272.9 180.9 389.2 48zM364.4 421.8h39.1L151.1 88h-42L364.4 421.8z\"/></svg>\n                            </a>\n                        </li>\n                        <li>\n                            <a href=\"https://www.instagram.com/evergreenhealth/?hl=en\">\n                                <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"><!--!Font Awesome Free 6.5.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.--><path d=\"M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.
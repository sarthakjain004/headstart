     "content": {
      "size": 25523,
      "mimeType": "text/html;charset=UTF-8",
      "compression": 20009,
      "text": "\n\n\n\n        \n    <!doctype html>\n    <html class=\"no-js\" lang=\"en-US\">\n            <head>\n        <meta charset=\"utf-8\">\n        <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n        <title>Barracuda Networks Inc. Careers</title>\n                    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\n        <link rel=\"shortcut icon\" href=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/images/favicon.ico?v=260807065713\" type=\"image/x-icon\">\n        <link rel=\"apple-touch-icon-precomposed\" href=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/images/apple-touch-icon-precomposed.png?v=260807065713\">\n\n        <link rel=\"stylesheet\" href=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/fonts/jobvite-icons/style.css?v=260807065713\">\n        <link rel=\"stylesheet\" href=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/styles/careersite/public-desktop.css?v=260807065713\">\n        <link rel=\"stylesheet\" href=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/scripts/careersite/public/flatpickr/v4/flatpickr.min.css?v=260807065713\">\n        <script src=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/scripts/careersite/public/modernizr-3.3.1-custom.min.js?v=260807065713\"></script>\n        <script src=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/lib/moment/moment-with-locales-2.29.4.min.js?v=260807065713\"></script>\n\n                    <!--[if lte IE 8]>\n                <script src=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/scripts/careersite/public/es5-shim.min.js?v=260807065713\"></script>\n            <![endif]-->\n\n\n<!-- CWS Company-wise Google Analytics -->\n<script type=\"text/javascript\">\n    function getUserId() { return ''; }\n</script>\n<script type=\"text/javascript\">\n    function getCompanyId() { return 'qTN9Vfwu'; }\n</script>\n<script type=\"text/javascript\">\n    try {\n        var enableAnonymizeIP = false;\n        var trackerId = \"UA-49585538-1\";\n        var gtagSrc = \"https://www.googletagmanager.com/gtag/js?id=\" + trackerId\n        document.write('<script async src=\"' + gtagSrc + '\"><\\/script>');\n\n        window.dataLayer = window.dataLayer || [];\n\n        function gtag() {\n            dataLayer.push(arguments);\n        }\n\n        gtag('js', new Date());\n        \n        gtag('config', trackerId, {\n            'custom_map': {\n                'dimension1': 'UserId',\n                'dimension2': 'CompanyId',\n                'dimension3': 'SubsidiaryId',\n                'dimension4': 'JobId',\n                'dimension5': 'CategoryId'\n            },\n            'UserId': getUserId(),\n            'CompanyId': getCompanyId(),\n            'SubsidiaryId': typeof getSubsidiaryId === 'function' ? getSubsidiaryId() : null,\n            'JobId': typeof getJobId === 'function' ? getJobId() : null,\n            'CategoryId': typeof getCategoryId === 'function' ? getCategoryId() : null,\n            'anonymize_ip': enableAnonymizeIP\n        });\n    } catch (err) {}\n</script>\n<!-- End of CWS Company-wise Google Analytics -->\n\n<!-- CWS Company-wise GainSight Analytics -->\n<script type=\"text/javascript\">\n    function getUserId() { return ''; }\n</script>\n<script type=\"text/javascript\">\n   function getCWSRole() {\n      var cwsRole = \"Visitor\";\n           if(\"search\" ===\"applyconfirm\"){\n             cwsRole = \"Applicant\";\n           }\n          return cwsRole;\n   }\n</script>\n<script type=\"text/javascript\">\nfunction getSfdc18DigitAccountNumber() {\n   return '001Ua00000DdjsVIAR';\n  }\n</script>\n<!-- Gainsight PX Tag-->\n    <script type=\"text/javascript\">\n       src=\"https://storage.googleapis.com/gainsight-px-cloud-public-assets/sdk/js/gpx-util.js\">\n    </script>\n    <script type=\"text/javascript\">\n     var userId = getUserId();\n     var samplePercentage = 1;\n     if(__IdSampler.isIdInSamplePopulation(userID,samplePercentage)){\n        (function(n,t,a,e,co){var i=\"aptrinsic\";n[i]
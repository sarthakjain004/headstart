      "compression": 31853,
      "text": "\n\n\n\n        \n    <!doctype html>\n    <html class=\"no-js\" lang=\"en-US\">\n            <head>\n        <meta charset=\"utf-8\">\n        <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n        <title>Barracuda Networks Inc. Careers - Cloud Site Reliability Senior Engineer</title>\n            <meta property=\"og:title\" content=\"Barracuda Networks Inc. is looking for Cloud Site Reliability Senior Engineer.\" />\n            <meta property=\"og:type\" content=\"website\" />\n        <meta property=\"og:image\" content=\"https://app.jobvite.com/logo/logobarracudaprimarystraplinepositivergb1200x628_1751392150990.jpg\" />\n            <meta property=\"og:description\" content=\"Barracuda Networks Inc. is looking for Cloud Site Reliability Senior Engineer. Learn more or Jobvite a friend.\" />\n            <meta name=\"twitter:card\" content=\"summary_large_image\" />\n                    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\n        <link rel=\"shortcut icon\" href=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/images/favicon.ico?v=260807065713\" type=\"image/x-icon\">\n        <link rel=\"apple-touch-icon-precomposed\" href=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/images/apple-touch-icon-precomposed.png?v=260807065713\">\n\n        <link rel=\"stylesheet\" href=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/fonts/jobvite-icons/style.css?v=260807065713\">\n        <link rel=\"stylesheet\" href=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/styles/careersite/public-desktop.css?v=260807065713\">\n        <link rel=\"stylesheet\" href=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/scripts/careersite/public/flatpickr/v4/flatpickr.min.css?v=260807065713\">\n        <script src=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/scripts/careersite/public/modernizr-3.3.1-custom.min.js?v=260807065713\"></script>\n        <script src=\"//d3igejkwe1ucjd.cloudfront.net/__assets__/lib/moment/moment-with-locales-2.29.4.min.
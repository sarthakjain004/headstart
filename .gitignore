# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local environment / secrets
.env
*.local

# Not part of this project (local Claude config / unrelated Fable-5 experiment)
.claude/
# …except project skills, which future sessions need
!.claude/
.claude/*
!.claude/skills/
CLAUDE-FABLE-5.md

# Other agent tools' local config, same reasoning as `.claude/` above. `.agents/skills/` is not
# un-ignored the way `.claude/skills/` is: it is a byte-identical copy of it, and a second tracked
# copy is a doc that drifts. `AGENTS.md` is tracked, but as a symlink to CLAUDE.md for the same
# reason — it was a real file, 76 lines behind, and being read as if current.
.agents/
.codex/

# HAR captures — large and contain browser session data; keep local only
HAR_Analysis/

# Experiment captures — screenshots/HTML with anti-bot session tokens; keep local.
experiment/

# Local config and data inputs — keep out of the repo. `config/*` rather than `config/`:
# git cannot re-include a file whose parent DIRECTORY is excluded, and the curated role
# taxonomy below must stay tracked (ADR-0040).
config/*
!config/fx_rates.json
!config/role_families.json
!config/role_watchlist.json
# The hand-curated Board -> company name map (ADR-0209).
!config/company_names.csv

# Regenerable pipeline scratch — run logs and superseded intermediates; safe to delete
data/scratch/

# Large local pipeline data — kept local, regenerable from the discovery/resolve scripts.
# Of data/ats-tenants-merged/ only the liveness-validated active/ subset is committed; the
# raw merged candidate CSVs and the scraped job feeds stay local.
data/resolve/
data/wayback-ats/
data/ats-companies/
data/discover/
data/ats-tenants-merged/*.csv
data/jobs/
# embedding vectors — large binary, regenerable from headstart.ingest.embed_run
data/embeddings/
# LanceDB vector store — regenerable from the embedding store via headstart.ingest.index sync
data/lancedb/
# CI round-trip state (board-priority ledger, ADR-0022) — lives in the HF dataset, not git
data/state/
# persisted Job descriptions (ADR-0050) — ~174 MB gzipped, lives in the HF dataset, not git
data/descriptions/
# enrichment outputs (extracted experience, etc.) — regenerable from scripts/enrich/
data/enrich/
# harvested external ATS company lists — large and regenerable from the merge scripts
data/ats-company-lists/
# liveness resume checkpoints (.{ats}_checked / .{ats}_dead), not data
data/ats-tenants-merged/active/.*
# point-in-time filter-verification reports (scripts/eval/verify_filters.py)
data/eval/filter_checks/
# The ADR-0129 write guard's fingerprint, written by `state_guard record` and read by `verify`
# minutes later in the same job. Runtime scratch, not data: it names every file under a prefix of
# the PRIVATE dataset with its blob id, and this repo is public.
data/.write_guard.json
# Subscription records pulled from the private headstart-subscribers dataset — email addresses,
# never committed to this public repo (ADR-0035). The data/ ignores above are per-directory, so a
# new top-level path needs its own line.
subscriptions/

# llm-router ops runbook — names private infrastructure (box address, key paths); this repo is
# public, so it must never be committed (ADR-0032). Lives locally only.
docs/LLM_API.md

# Discovery-technique ranking — local working notes on where to spend discovery effort next.
docs/discovery/technique-ranking.md

# deploy-space.yml sync artifacts (ADR-0153) — CI stages the whole headstart package and
# config/ here before pushing to the Space; a stale local copy from a manual staging run
# would otherwise show up as untracked cruft.
deploy/hf-space/headstart/
deploy/hf-space/config/
.DS_Store

# Public-launch checklist — local working notes on readying the repo to share. Lives locally only.
docs/launch/

# Recruiting-contact research notes — kept local, out of the public repo.
docs/hr-contacts/
